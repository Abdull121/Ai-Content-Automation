# Copy to .env.local and fill in. Never commit .env.local.

# --- Appwrite (server-side only; the API key must never reach the browser) ---
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_BUCKET_ID=

# --- Google / YouTube OAuth (Cloud Console → Credentials → OAuth client, type "Web application") ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://localhost:3000/api/auth/youtube/callback

# --- Instagram (Meta developer app → Instagram API with Instagram Login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=https://localhost:3000/api/auth/instagram/callback

# --- Groq (Whisper transcription + LLM metadata) ---
GROQ_API_KEY=

# --- Optional: protects POST /api/publish/run. When set, callers must send
#     "Authorization: Bearer <value>". Strongly recommended on any public deployment.
CRON_SECRET=
